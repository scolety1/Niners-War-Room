{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "redraft-main-runtime",
  "description": "Allows the bundled Redraft main window to request only its local API session descriptor.",
  "local": true,
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-desktop-runtime",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
